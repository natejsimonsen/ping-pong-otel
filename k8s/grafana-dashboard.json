{
  "dashboard": {
    "title": "Sacramento Table Tennis Club",
    "uid": "pong-metrics",
    "timezone": "browser",
    "style": "dark",
    "panels": [
      {
        "id": 10,
        "title": "",
        "type": "text",
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
        "options": {
          "mode": "markdown",
          "content": "# Player Performance"
        },
        "transparent": true
      },
      {
        "id": 1,
        "title": "Rating Over Time",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 2 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_rating{player=~\"$player\", }[90d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "pointSize": 4,
              "showPoints": "never",
              "fillOpacity": 8,
              "gradientMode": "opacity"
            },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min", "max", "mean"] }
        }
      },
      {
        "id": 2,
        "title": "Rating Change",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_rating_change{player=~\"$player\", }[90d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 85,
              "spanNulls": true,
              "lineWidth": 0
            },
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "#F2495C", "value": null },
                { "color": "#FF9830", "value": -10 },
                { "color": "#73BF69", "value": 0 },
                { "color": "#56A64B", "value": 20 }
              ]
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 3,
        "title": "Wins / Losses",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_wins{player=~\"$player\", }[90d])",
            "legendFormat": "{{player}} W",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          },
          {
            "expr": "last_over_time(pong_player_losses{player=~\"$player\", }[90d])",
            "legendFormat": "{{player}} L",
            "refId": "B",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 85,
              "stacking": { "mode": "normal" },
              "spanNulls": true,
              "lineWidth": 0
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byRegexp", "options": ".* W$" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }
              ]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".* L$" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } },
                { "id": "custom.transform", "value": "negative-Y" }
              ]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 4,
        "title": "Table Assignment (up = stronger)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "-1 * last_over_time(pong_player_table{player=~\"$player\", }[90d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "pointSize": 4,
              "showPoints": "never",
              "fillOpacity": 8,
              "gradientMode": "opacity",
              "axisLabel": "Table",
              "axisSoftMin": -12,
              "axisSoftMax": -1
            },
            "color": { "mode": "palette-classic" },
            "decimals": 0,
            "mappings": [
              { "type": "value", "options": { "-1": { "text": "1" }, "-2": { "text": "2" }, "-3": { "text": "3" }, "-4": { "text": "4" }, "-5": { "text": "5" }, "-6": { "text": "6" }, "-7": { "text": "7" }, "-8": { "text": "8" }, "-9": { "text": "9" }, "-10": { "text": "10" }, "-11": { "text": "11" }, "-12": { "text": "12" } } }
            ]
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 20,
        "title": "",
        "type": "text",
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 28 },
        "options": {
          "mode": "markdown",
          "content": "# Club Overview"
        },
        "transparent": true
      },
      {
        "id": 5,
        "title": "Event Attendance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
        "targets": [
          {
            "expr": "last_over_time(pong_event_player_count[90d])",
            "legendFormat": "Players",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "fixed", "fixedColor": "#8AB8FF" },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "gradientMode": "opacity",
              "spanNulls": true,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 6,
        "title": "Club Mean Rating",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
        "targets": [
          {
            "expr": "last_over_time(pong_event_mean_rating[90d])",
            "legendFormat": "Mean Rating",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "fixed", "fixedColor": "#FADE2A" },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "fillOpacity": 12,
              "gradientMode": "opacity",
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "player",
          "type": "query",
          "query": "label_values(pong_player_rating{}, player)",
          "datasource": { "uid": "prometheus", "type": "prometheus" },
          "multi": true,
          "includeAll": false,
          "current": { "text": "Nate Simonsen", "value": "Nate Simonsen" },
          "refresh": 2,
          "sort": 1
        }
      ]
    },
    "time": { "from": "now-1y", "to": "now" },
    "refresh": ""
  },
  "overwrite": true
}
