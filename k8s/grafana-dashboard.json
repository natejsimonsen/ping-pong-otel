{
  "dashboard": {
    "title": "Pong Metrics",
    "uid": "pong-metrics",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Player Rating Over Time",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_rating{player=~\"$player\", event_id=\"\"}[14d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min", "max"] }
        }
      },
      {
        "id": 2,
        "title": "Rating Change Per Event",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_rating_change{player=~\"$player\", event_id=\"\"}[14d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80,
              "spanNulls": true
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 3,
        "title": "Wins / Losses Per Event",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_wins{player=~\"$player\", event_id=\"\"}[14d])",
            "legendFormat": "{{player}} wins",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          },
          {
            "expr": "last_over_time(pong_player_losses{player=~\"$player\", event_id=\"\"}[14d])",
            "legendFormat": "{{player}} losses",
            "refId": "B",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80,
              "stacking": { "mode": "normal" },
              "spanNulls": true
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byRegexp", "options": ".*losses" },
              "properties": [
                { "id": "custom.transform", "value": "negative-Y" }
              ]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 4,
        "title": "Table Assignment",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "last_over_time(pong_player_table{player=~\"$player\", event_id=\"\"}[14d])",
            "legendFormat": "{{player}}",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "asc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 5,
        "title": "Event Player Count",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
        "targets": [
          {
            "expr": "last_over_time(pong_event_player_count{event_id!=\"\"}[14d])",
            "legendFormat": "Player Count",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "fixed", "fixedColor": "blue" },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 20,
              "spanNulls": true
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 6,
        "title": "Event Mean Rating",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
        "targets": [
          {
            "expr": "last_over_time(pong_event_mean_rating{event_id!=\"\"}[14d])",
            "legendFormat": "Mean Rating",
            "refId": "A",
            "datasource": { "uid": "prometheus", "type": "prometheus" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "fixed", "fixedColor": "orange" },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "spanNulls": true,
              "fillOpacity": 20
            }
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "player",
          "type": "query",
          "query": "label_values(pong_player_rating{event_id=\"\"}, player)",
          "datasource": { "uid": "prometheus", "type": "prometheus" },
          "multi": true,
          "includeAll": false,
          "current": { "text": "Nate Simonsen", "value": "Nate Simonsen" },
          "refresh": 2
        }
      ]
    },
    "time": { "from": "2022-01-01T00:00:00.000Z", "to": "now" },
    "refresh": ""
  },
  "overwrite": true
}
